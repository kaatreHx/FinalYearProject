// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(uuid())
  firstName      String
  middleName     String?
  lastName       String
  phone          String?         @unique
  email          String          @unique
  password       String
  kycApplication KycApplication?
  isAgent        Boolean         @default(false)
  isGovernment   Boolean         @default(false) // NEW: government officer flag (set manually in DB)
  properties     Property[]                      // NEW: back-relation required by Property.seller
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  NATIONAL_ID
  CITIZENSHIP
  PASSPORT
  DRIVERS_LICENSE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model KycApplication {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  // Personal Identity
  firstName  String
  middleName String?
  lastName   String
  dob        DateTime
  gender     Gender

  // Identity Document Details
  documentType       DocumentType
  documentNumber     String
  documentExpiryDate DateTime

  // Address Information
  street String
  city   String
  zip    String

  // File Uploads (Proof) - store paths/URLs
  documentFrontUrl String
  documentBackUrl  String
  selfieUrl        String

  status       KycStatus @default(PENDING)
  rejectReason String?

  // FIXED: these two were swapped in your original
  // (createdAt had @updatedAt, updatedAt had @default(now()))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PropertyStatus {
  PENDING    // seller submitted, waiting for government
  DISPATCHED // sent to / picked up by the government for verification
  VERIFIED   // government confirmed ownership; ready to mint
  REJECTED   // government rejected; seller may edit & resubmit
  MINTING    // mint tx in flight (lock state, prevents double mint)
  MINTED     // NFT minted
}

enum PropertyType {
  HOUSE
  APARTMENT
  LAND
  COMMERCIAL
}

enum PropertyFileKind {
  IMAGE
  DOCUMENT
}

model Property {
  id       String @id @default(uuid())
  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id])

  title                  String
  description            String       @db.Text
  propertyType           PropertyType
  price                  Decimal      @db.Decimal(18, 2)
  areaSqFt               Float
  bedrooms               Int?
  bathrooms              Int?
  street                 String
  city                   String
  zip                    String
  landRegistrationNumber String

  status PropertyStatus @default(PENDING)

  // government review
  dispatchedAt        DateTime?
  verifiedAt          DateTime?
  verifiedById        String?
  governmentRefNumber String?
  verificationNotes   String?
  rejectReason        String?

  // NFT
  ownerWalletAddress String?
  tokenId            String?
  contractAddress    String?
  mintTxHash         String?
  mintedAt           DateTime?

  files      PropertyFile[]
  statusLogs PropertyStatusLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([sellerId])
  @@index([city])
  @@index([landRegistrationNumber])
}

model PropertyFile {
  id           String           @id @default(uuid())
  propertyId   String
  property     Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  kind         PropertyFileKind
  fileName     String
  originalName String
  mimeType     String
  size         Int
  createdAt    DateTime         @default(now())

  @@index([propertyId])
}

model PropertyStatusLog {
  id         String          @id @default(uuid())
  propertyId String
  property   Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  fromStatus PropertyStatus?
  toStatus   PropertyStatus
  actorId    String
  note       String?
  createdAt  DateTime        @default(now())

  @@index([propertyId])
}
