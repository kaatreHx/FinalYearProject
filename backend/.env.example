# Server
PORT=4000
# Base URL the backend is reachable at (used for NFT metadata URLs)
PUBLIC_API_URL=http://localhost:4000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/landchain

# Auth
JWT_SECRET=change-this-to-a-long-random-string

# Blockchain (local Hardhat node)
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# Government wallet = Hardhat account #0 by default
GOVERNMENT_WALLET=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
# Private key of the government wallet (Hardhat account #0). Used ONLY to mint
# property NFTs and to approve transfers server-side.
GOVERNMENT_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Filled in automatically by the deploy script (contracts/deployments/localhost.json)
PROPERTY_NFT_ADDRESS=
MARKETPLACE_ADDRESS=
